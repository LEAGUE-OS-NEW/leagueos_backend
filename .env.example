DJANGO_SECRET_KEY=replace-this-with-a-long-random-development-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Initial admin bootstrapping (DEVELOPMENT ONLY)
# ---------------------------------------------------------------------------
# Used by `python manage.py bootstrap_admins`. If these are NOT set, the
# command falls back to the local development password (Strong123!) ONLY when
# DEBUG=True. In any non-development environment (DEBUG=False) the command
# REFUSES to run without these and no fallback is used.
# The default development password MUST be changed before production.
# Leave these empty to rely on the DEBUG-only development fallback locally,
# or set strong values here / in the deployment environment.
SUPER_ADMIN_INITIAL_PASSWORD=
CLUB_ADMIN_INITIAL_PASSWORD=
# Optional: name of the club the Club Admin is bound to. Defaults to
# "League OS Development" when unset. Resolved by name/slug (never by DB id).
CLUB_ADMIN_CLUB_NAME=

POSTGRES_DB=leagueos
POSTGRES_USER=leagueos
POSTGRES_PASSWORD=leagueos_local_password

DATABASE_URL=postgresql://leagueos:leagueos_local_password@db:5432/leagueos

# Registration verification is email-only until an SMS provider is configured.
REGISTRATION_OTP_CHANNEL=EMAIL
SMS_OTP_ENABLED=False
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_MINUTES=2
OTP_MAX_DAILY_RESENDS=5
OTP_MAX_VERIFICATION_ATTEMPTS=5
OTP_VERIFICATION_LOCK_MINUTES=15

# Brevo SMTP credentials (leave secrets empty in committed files).
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@leagueos.com
ACCOUNT_SETUP_URL=http://localhost:5173/accept-invite
ADMIN_INVITE_URL=http://localhost:5173/accept-admin-invite

MARKET_MINIMUM_AGE=18
MARKET_ALLOWED_COUNTRY_CODES=
MARKET_KYC_PROVIDER=manual
# Set to a strong secret in each deployed environment. Empty rejects all callbacks.
MARKET_KYC_WEBHOOK_SECRET=
MARKET_KYC_WEBHOOK_TOLERANCE_SECONDS=300
MARKET_KYC_MAX_CALLBACK_BYTES=65536
MARKET_KYC_SESSION_HOURS=24
REVIEW_WORKFLOW_TOOLS_ENABLED=False
DEV_KYC_BYPASS_ENABLED=False
DEV_RESULT_ACCELERATOR_ENABLED=False
MARKET_BLOCKED_COUNTRY_CODES=
MARKET_RESPONSIBLE_DEFAULT_MAX_ORDER_NOTIONAL=
MARKET_RESPONSIBLE_DEFAULT_DAILY_BUY_NOTIONAL=
MARKET_RESPONSIBLE_DEFAULT_WEEKLY_BUY_NOTIONAL=
MARKET_RESPONSIBLE_DEFAULT_MAX_OPEN_BUY_COMMITMENT=
MARKET_RESPONSIBLE_DEFAULT_MAX_MARKET_EXPOSURE=
MARKET_RESPONSIBLE_DEFAULT_MAX_TOTAL_EXPOSURE=
MARKET_RESPONSIBLE_DEFAULT_MAX_CUMULATIVE_REALIZED_LOSS=
# JWT session lifetimes (refresh tokens rotate and old tokens are blacklisted)
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=14

# ------------------------------------------------------------------
# Pesapal API 3.0
# ------------------------------------------------------------------
# Keep SANDBOX for development/staging.
# Production must be enabled explicitly and use separate credentials.

PESAPAL_ENVIRONMENT=SANDBOX

# Pesapal API 3.0 sandbox base URL.
PESAPAL_SANDBOX_BASE_URL=https://cybqa.pesapal.com/pesapalv3

# Production URL is documented here but MUST NOT be used unless
# PESAPAL_ENVIRONMENT=LIVE and PESAPAL_LIVE_ENABLED=True.
PESAPAL_LIVE_BASE_URL=https://pay.pesapal.com/v3

# Obtain these from Pesapal's sandbox/test credentials.
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=

# Returned after registering the League OS sandbox IPN URL.
PESAPAL_IPN_ID=

# Public HTTPS URLs used by Pesapal sandbox.
PESAPAL_CALLBACK_URL=
PESAPAL_IPN_URL=

# Hard safety switch. Leave False for local/staging.
PESAPAL_LIVE_ENABLED=False

# Where League OS sends the browser after the backend has processed
# a Pesapal callback. For local frontend testing this may be:
# http://localhost:5173/fan/wallet
PESAPAL_FRONTEND_RETURN_URL=

# Wallet withdrawal automatic approval
WALLET_WITHDRAWAL_AUTO_APPROVAL_ENABLED=True
WALLET_WITHDRAWAL_AUTO_APPROVAL_MAX_SINGLE_UGX=250000
WALLET_WITHDRAWAL_AUTO_APPROVAL_MAX_24H_UGX=500000
WALLET_WITHDRAWAL_AUTO_APPROVAL_MAX_24H_COUNT=3
WALLET_WITHDRAWAL_AUTO_APPROVAL_MAX_7D_UGX=1500000
WALLET_WITHDRAWAL_AUTO_APPROVAL_REQUIRE_KNOWN_DESTINATION=True


# ---------------------------------------------------------------------------
# S3-compatible media storage
# ---------------------------------------------------------------------------
# local = filesystem
# s3/minio/r2 = S3-compatible public + private buckets
STORAGE_BACKEND=local

# Never commit real credentials.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# SeaweedFS production example:
# S3_ENDPOINT_URL=http://object-storage:8333
S3_ENDPOINT_URL=
S3_REGION_NAME=us-east-1
S3_ADDRESSING_STYLE=path

S3_PUBLIC_BUCKET_NAME=league-os-public
S3_PRIVATE_BUCKET_NAME=league-os-private

# Browser-facing public media endpoint/domain.
# Example:
# 167.172.200.127/storage/league-os-public
S3_PUBLIC_CUSTOM_DOMAIN=
S3_PUBLIC_URL_PROTOCOL=https:
S3_PUBLIC_CACHE_CONTROL=public, max-age=86400

# Browser-facing base used to rewrite private presigned URLs.
# Example:
# https://example.com/storage
S3_PRIVATE_EXTERNAL_BASE_URL=
S3_PRIVATE_URL_EXPIRY=900

# Existing production buckets should normally use False.
S3_MANAGE_BUCKET_POLICIES=False
S3_BOOTSTRAP_MAX_ATTEMPTS=30
S3_BOOTSTRAP_RETRY_SECONDS=2
