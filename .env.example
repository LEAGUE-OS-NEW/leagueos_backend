DJANGO_SECRET_KEY=replace-this-with-a-long-random-development-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

POSTGRES_DB=leagueos
POSTGRES_USER=leagueos
POSTGRES_PASSWORD=leagueos_local_password

DATABASE_URL=postgresql://leagueos:leagueos_local_password@db:5432/leagueos

# Registration verification is email-only until an SMS provider is configured.
REGISTRATION_OTP_CHANNEL=EMAIL
SMS_OTP_ENABLED=False
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_MINUTES=2
OTP_MAX_DAILY_RESENDS=5
OTP_MAX_VERIFICATION_ATTEMPTS=5
OTP_VERIFICATION_LOCK_MINUTES=15

# Brevo SMTP credentials (leave secrets empty in committed files).
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@leagueos.com

MARKET_MINIMUM_AGE=18
MARKET_ALLOWED_COUNTRY_CODES=
MARKET_KYC_PROVIDER=manual
# Set to a strong secret in each deployed environment. Empty rejects all callbacks.
MARKET_KYC_WEBHOOK_SECRET=
MARKET_KYC_WEBHOOK_TOLERANCE_SECONDS=300
MARKET_KYC_MAX_CALLBACK_BYTES=65536
MARKET_KYC_SESSION_HOURS=24
MARKET_BLOCKED_COUNTRY_CODES=
MARKET_RESPONSIBLE_DEFAULT_MAX_ORDER_NOTIONAL=
MARKET_RESPONSIBLE_DEFAULT_DAILY_BUY_NOTIONAL=
MARKET_RESPONSIBLE_DEFAULT_WEEKLY_BUY_NOTIONAL=
MARKET_RESPONSIBLE_DEFAULT_MAX_OPEN_BUY_COMMITMENT=
MARKET_RESPONSIBLE_DEFAULT_MAX_MARKET_EXPOSURE=
MARKET_RESPONSIBLE_DEFAULT_MAX_TOTAL_EXPOSURE=
MARKET_RESPONSIBLE_DEFAULT_MAX_CUMULATIVE_REALIZED_LOSS=
